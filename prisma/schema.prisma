// Prisma Schema for Business Operations Automation System
// Milestone 1: System Foundation

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  REQUESTER
  OPERATOR
  MANAGER
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  NEW
  PROCESSING
  AWAITING_REVIEW
  AWAITING_APPROVAL
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  DECIDED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  role        UserRole  @default(REQUESTER)
  department  String
  created_at  DateTime  @default(now())

  // Relations
  requested_requests Request[]       @relation("Requester")
  assigned_requests  Request[]       @relation("AssignedTo")
  assigned_tasks     Task[]          @relation("TaskAssignee")
  approvals          Approval[]      @relation("Approver")
  activity_events    ActivityEvent[] @relation("Actor")
  notifications      NotificationEvent[] @relation("NotificationRecipient")

  @@map("users")
}

model Request {
  id           String        @id @default(uuid())
  title        String
  description  String
  request_type String
  priority     Priority      @default(MEDIUM)
  status       RequestStatus @default(NEW)
  requester_id String
  assigned_to  String?
  source       String        @default("MANUAL")
  due_at       DateTime?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  // Foreign key relations
  requester User  @relation("Requester", fields: [requester_id], references: [id], onDelete: Restrict)
  assignee  User? @relation("AssignedTo", fields: [assigned_to], references: [id], onDelete: SetNull)

  // Children relations
  tasks           Task[]
  approvals       Approval[]
  attachments     Attachment[]
  activity_events ActivityEvent[]
  ai_analyses     RequestAiAnalysis[]
  notification_events NotificationEvent[]
  executions      WorkflowExecution[]

  @@index([status])
  @@index([requester_id])
  @@index([assigned_to])
  @@index([request_type])
  @@map("requests")
}

model Task {
  id           String     @id @default(uuid())
  request_id   String
  title        String
  description  String?
  assigned_to  String?
  status       TaskStatus @default(PENDING)
  priority     Priority   @default(MEDIUM)
  due_at       DateTime?
  completed_at DateTime?
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  // Relations
  request  Request @relation(fields: [request_id], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  notification_events NotificationEvent[]

  @@index([request_id])
  @@index([assigned_to])
  @@index([status])
  @@map("tasks")
}

model Approval {
  id          String            @id @default(uuid())
  request_id  String
  approver_id String
  status      ApprovalStatus    @default(PENDING)
  decision    ApprovalDecision?
  comment     String?
  decided_at  DateTime?
  created_at  DateTime          @default(now())

  // Relations
  request  Request @relation(fields: [request_id], references: [id], onDelete: Cascade)
  approver User    @relation("Approver", fields: [approver_id], references: [id], onDelete: Restrict)

  @@index([request_id])
  @@index([approver_id])
  @@map("approvals")
}

model Attachment {
  id          String   @id @default(uuid())
  request_id  String
  file_name   String
  file_url    String
  file_type   String
  file_size   Int
  status      String   @default("UPLOADED")
  uploaded_at DateTime @default(now())

  // Relations
  request Request @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@map("attachments")
}

model ActivityEvent {
  id          String   @id @default(uuid())
  request_id  String
  actor_id    String?
  event_type  String
  description String
  metadata    Json?
  created_at  DateTime @default(now())

  // Relations
  request Request @relation(fields: [request_id], references: [id], onDelete: Cascade)
  actor   User?   @relation("Actor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([request_id])
  @@index([created_at])
  @@map("activity_events")
}

model RequestAiAnalysis {
  id                   String   @id @default(uuid())
  request_id           String
  request_type         String
  priority             Priority @default(MEDIUM)
  summary              String
  suggested_department String
  confidence           Float    @default(1.0)
  entities             Json?
  documents_mentioned  Json?
  missing_information  Json?
  is_actionable        Boolean  @default(true)
  raw_response         Json?
  model_name           String?  @default("deterministic-classifier-v1")
  created_at           DateTime @default(now())

  // Relations
  request Request @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@index([request_type])
  @@map("request_ai_analysis")
}

model NotificationEvent {
  id           String    @id @default(uuid())
  request_id   String?
  task_id      String?
  type         String    // NOTIFICATION_REQUESTED, TASK_ASSIGNED, APPROVAL_REQUESTED, TASK_DUE_SOON, TASK_OVERDUE, TASK_ESCALATED, REQUEST_OVERDUE
  recipient_id String?
  channel      String    @default("WEBHOOK")
  status       String    @default("SENT")
  payload      Json?
  sent_at      DateTime? @default(now())
  created_at   DateTime  @default(now())

  // Relations
  request   Request? @relation(fields: [request_id], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [task_id], references: [id], onDelete: Cascade)
  recipient User?    @relation("NotificationRecipient", fields: [recipient_id], references: [id], onDelete: SetNull)

  @@index([task_id, type])
  @@index([request_id, type])
  @@index([recipient_id])
  @@map("notification_events")
}

model ProcessedEvent {
  id           String    @id @default(uuid())
  event_id     String    @unique
  event_type   String
  payload      Json?
  result       Json?
  processed_at DateTime  @default(now())

  @@index([event_id])
  @@index([event_type])
  @@map("processed_events")
}

model WorkflowExecution {
  id            String    @id @default(uuid())
  request_id    String
  workflow_type String
  status        String    // RUNNING, SUCCESS, FAILED, RETRYING
  attempt       Int       @default(1)
  max_attempts  Int       @default(3)
  error         String?
  context       Json?
  started_at    DateTime  @default(now())
  completed_at  DateTime?

  // Relations
  request Request @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@index([status])
  @@map("workflow_executions")
}


